#!/bin/sh
# Ningún push a main con las pruebas rotas: publicar.yml las ejecuta y, si fallan, no sale ningún episodio.
# Las pruebas crean repos temporales: sin esto heredan el GIT_DIR del hook y escriben en el repo real (11 oct 2026).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
python3 -m unittest discover -s tests -q >/tmp/claves_pruebas.log 2>&1 || {
  echo "Pruebas rotas: push cancelado. Mira /tmp/claves_pruebas.log y arréglalo antes de subir." >&2
  tail -15 /tmp/claves_pruebas.log >&2
  exit 1
}
